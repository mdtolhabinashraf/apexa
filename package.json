{
  "name": "apexa",
  "version": "2.0.0",
  "description": "A production-ready, TypeScript-first HTTP client built on the Fetch API.",
  "license": "MIT",
  "author": {
    "name": "Md. Tolha Bin Ashraf",
    "url": "https://github.com/mdtolhabinashraf"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mdtolhabinashraf/apexa.git"
  },
  "homepage": "https://github.com/mdtolhabinashraf/apexa#readme",
  "bugs": {
    "url": "https://github.com/mdtolhabinashraf/apexa/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs/API.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "clean": "node -e \"import('node:fs').then(fs => fs.rmSync('dist', { recursive: true, force: true }))\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "test": "vitest run",
    "test:typecheck": "tsc --noEmit -p tsconfig.tests.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepack": "npm run typecheck && npm run test:typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "keywords": [
    "api-client",
    "fetch",
    "http",
    "http-client",
    "interceptors",
    "request",
    "response",
    "typescript",
    "web-api"
  ]
}
